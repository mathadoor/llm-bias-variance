# Copy to .env (git-ignored) and fill in what you use. LiteLLM reads these automatically.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local servers on the host. Use host.docker.internal, not localhost, from inside the container.
# The server must listen on 0.0.0.0 (e.g. OLLAMA_HOST=0.0.0.0, llama-server --host 0.0.0.0).
OLLAMA_API_BASE=http://host.docker.internal:11434
# llama.cpp: model="openai/<name>", api_base="http://host.docker.internal:8080/v1", api_key="none"

# MLFLOW_TRACKING_URI=http://host.docker.internal:5000
# HF_CACHE_DIR=
# HOST_UID=1000
# HOST_GID=1000
